# ─── Base de données ────────────────────────────────────────────────
# PostgreSQL (Neon en production). `prisma migrate deploy` applique les
# migrations, `npx prisma db seed` charge les données de démarrage.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Authentification admin (NextAuth) ──────────────────────────────
# Secret obligatoire : le middleware refuse de démarrer sans lui.
# Génération : openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# URL publique du site — sert aussi à construire les liens des emails.
NEXTAUTH_URL="http://localhost:3000"

# ─── Paiement GeniusPay ─────────────────────────────────────────────
# Sans ces clés, /api/payments répond 503 (paiement désactivé).
GENIUSPAY_PUBLIC_KEY=""
GENIUSPAY_SECRET_KEY=""
# Secret de signature des webhooks : sans lui, tous les webhooks sont rejetés.
GENIUSPAY_WEBHOOK_SECRET=""

# ─── Emails transactionnels (Resend) ────────────────────────────────
# Absent = les emails sont ignorés silencieusement (le reste fonctionne).
RESEND_API_KEY=""
EMAIL_FROM="AIKO Board <contact@aikoboard.com>"
# Destinataire des notifications internes (inscriptions, paiements).
ADMIN_NOTIFICATION_EMAIL="admin@aikoboard.com"

# ─── Images (Cloudinary) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Rate limiting distribué (Upstash Redis) ────────────────────────
# Optionnel : sans Redis, le rate limit retombe sur un compteur mémoire
# (par instance — suffisant en dev, insuffisant en production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Cron Vercel ────────────────────────────────────────────────────
# Attendu en Bearer sur /api/cron/reminders (rappels J-1, 8h).
CRON_SECRET=""
